# ==============================================================================
# Plant Monitor — Environment Configuration Template
# Copy this file to .env and customize for your environment: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Configuration
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.11.110
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
HTTPS_ENABLED=False

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DATABASE_NAME=plantmonitor
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ------------------------------------------------------------------------------
# 3. Redis Cache Configuration (Optional)
# ------------------------------------------------------------------------------
USE_REDIS=False
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Telegram Alert & Notification Bot
# ------------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=123456789,-100123456789
TELEGRAM_NO_SIGNAL_MINUTES=3
TELEGRAM_SSL_VERIFY=true
TELEGRAM_STATUS_CHANGES=true
